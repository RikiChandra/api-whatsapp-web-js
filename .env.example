NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Shared secret. Laravel calls this engine with:
#   Authorization: Bearer <SERVICE_TOKEN>
#   or header X-Api-Token
SERVICE_TOKEN=change-me

DEFAULT_SESSION=main
SESSION_DIR=./sessions
AUTO_START_SESSIONS=true

# Optional Chrome. Leave empty to use Puppeteer's downloaded Chromium.
# If this path is missing, the engine falls back automatically.
# PUPPETEER_CACHE_DIR=C:\Users\user\.cache\puppeteer
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
