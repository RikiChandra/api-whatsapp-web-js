NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Shared secret. Laravel calls this engine with:
#   Authorization: Bearer <SERVICE_TOKEN>
#   or header X-Api-Token
SERVICE_TOKEN=change-me

DEFAULT_SESSION=main
SESSION_DIR=./sessions
AUTO_START_SESSIONS=true

# Optional Chrome. Engine auto-detects installed Google Chrome on Windows.
# Set these if it runs as a Windows service / SYSTEM account.
# PUPPETEER_CACHE_DIR=C:\Users\user\.cache\puppeteer
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
